# === Discord Bot ===
DISCORD_TOKEN=dein-discord-bot-token-hier
DISCORD_CLIENT_ID=deine-application-id-hier
DISCORD_GUILD_ID=deine-server-id-hier-optional-fuer-testing

# === Zappify API ===
# API_KEY muss mit api.key in Zappifys config/app-settings.json uebereinstimmen.
# Zappify generiert den Key beim ersten Start automatisch.
API_URL=http://127.0.0.1:3000
API_KEY=dein-api-key-aus-app-settings-hier

# === Zappify Datenpfade ===
# Der Bot liest die Datenbank IMMER direkt (read-only, WAL-safe) und schreibt
# ausschliesslich ueber die API. Ist Zappify aus, landen Schreibvorgaenge in
# pending-*.json und werden beim naechsten Zappify-Start uebernommen.
# WICHTIG: Backslashes in Windows-Pfaden escapen (\\)
VISUALIZER_PATH=C:\\Streaming\\Code\\visual
USERS_DB_PATH=C:\\Users\\DEIN_USER\\AppData\\Roaming\\zappify\\data\\users.db
ASSETS_PATH=C:\\Streaming\\Code\\visual\\assets\\tts-characters
# Schreib-Queue (Standard: config/pending-writes.json im Bot-Ordner).
# Zappify liest sie beim Start und arbeitet gepufferte Punkte-Writes ab.
# PENDING_WRITES_PATH=
# AVATAR_COOLDOWNS_PATH=

# === Leaderboard ===
LEADERBOARD_CHANNEL_ID=deine-channel-id-hier
PUNKTE_CHANNEL_ID=deine-channel-id-hier
# Ausgeschlossene User (komma-getrennt, case-insensitive)
LEADERBOARD_EXCLUDED_USERS=test_user,bot_name

# === Logging ===
LOG_LEVEL=info

# === Doku-/Feedback-Channels (optional) ===
DOCS_CHANNEL_ID=
FEATURES_CHANNEL_ID=
CHANGELOG_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
DOCS_FORUM_CHANNEL_ID=
DOCS_CHANGELOG_THREAD_ID=
DOCS_OVERVIEW_THREAD_ID=

# === User-Image (Bild per Reaktion in den Stream) ===
USER_IMAGE_ENABLED=false
USER_IMAGE_CHANNELS=
USER_IMAGE_MOD_ROLE=Discord Master

# === Asset-Sync: Forum-Thread-IDs pro Kategorie (optional) ===
ASSET_THREAD_HINTERGRUND=
ASSET_THREAD_KOERPER=
ASSET_THREAD_KOPF=
ASSET_THREAD_AUGEN=
ASSET_THREAD_HUT=
ASSET_THREAD_RAHMEN=

# === Custom-Avatar-Upload (optional) ===
CUSTOM_AVATAR_CHANNEL_ID=
CUSTOM_AVATAR_VERIFY_PATH=

# === Meme-Sync (optional) ===
MEME_CHANNEL_ID=
MEME_PATH=
# MEME_SYNC_INTERVAL=300000

# === SSP-Battle (optional) ===
BATTLE_CHANNEL_ID=

# === Bad-Word-Filter-Alerts (optional) ===
BADWORD_CHANNEL_ID=
