# =====================================================================
#  Diese .env ist nur fuer den MANUELLEN / Playground-Betrieb noetig.
#
#  Im Kunden-Setup verwaltet Zappify alles: der Bot-Token liegt dort
#  verschluesselt (Windows DPAPI) und wird beim Start als Umgebungs-
#  variable uebergeben, die uebrigen Einstellungen stehen in
#  config/bot-settings.json (siehe bot-settings.json.example).
#  -> Discord-Bot-Assistent in Zappify: Einstellungen -> Integrationen.
# =====================================================================

# === Discord Bot ===
DISCORD_TOKEN=dein-discord-bot-token-hier
DISCORD_CLIENT_ID=deine-application-id-hier
DISCORD_GUILD_ID=deine-server-id-optional-fuer-sofort-aktive-commands

# === Zappify API ===
# Lokale Requests (127.0.0.1) brauchen KEINEN Key. API_KEY nur setzen, wenn der
# Bot auf einem anderen Rechner laeuft (dann in Zappify api.exposeToNetwork=true).
API_URL=http://127.0.0.1:3000
# API_KEY=

# === Profil ===
# 'customer' = schlanker Kunden-Modus (keine Aaronius-Doku-/Sync-Services,
# kein direkter DB-Zugriff). Standard: playground.
# ZAPPIFY_BOT_PROFILE=playground

# === Playground-Datenpfade (nur profile=playground) ===
# VISUALIZER_PATH=C:\\Streaming\\Code\\visual
# USERS_DB_PATH=C:\\Users\\DEIN_USER\\AppData\\Roaming\\zappify\\data\\users.db
# ASSETS_PATH=C:\\Streaming\\Code\\visual\\assets\\tts-characters
# PENDING_WRITES_PATH=
# LEADERBOARD_STATE_PATH=

# === Leaderboard ===
LEADERBOARD_CHANNEL_ID=
PUNKTE_CHANNEL_ID=
LEADERBOARD_EXCLUDED_USERS=

# === Features (Zappify setzt das anhand aktiver Module) ===
# FEATURE_SSP=true
# FEATURE_BINGO=true

# === User-Image (Bild per Reaktion in den Stream) ===
USER_IMAGE_ENABLED=false
USER_IMAGE_CHANNELS=
USER_IMAGE_MOD_ROLE=Discord Master

# === Custom-Avatar-Upload (optional) ===
CUSTOM_AVATAR_CHANNEL_ID=

# === SSP-Battle (optional) ===
BATTLE_CHANNEL_ID=

# === Logging ===
LOG_LEVEL=info

# =====================================================================
#  Ab hier: nur Aaronius / profile=playground (Doku-/Sync-Channels)
# =====================================================================
# DOCS_CHANNEL_ID=
# FEATURES_CHANNEL_ID=
# CHANGELOG_CHANNEL_ID=
# DOCS_FORUM_CHANNEL_ID=
# DOCS_CHANGELOG_THREAD_ID=
# DOCS_OVERVIEW_THREAD_ID=
# ASSET_THREAD_HINTERGRUND=
# ASSET_THREAD_KOERPER=
# ASSET_THREAD_KOPF=
# ASSET_THREAD_AUGEN=
# ASSET_THREAD_HUT=
# ASSET_THREAD_RAHMEN=
# MEME_CHANNEL_ID=
# MEME_PATH=
# BADWORD_CHANNEL_ID=
# BUGFIX_CHANNEL_ID=
